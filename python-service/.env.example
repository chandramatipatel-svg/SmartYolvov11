# Next.js API configuration
NEXTJS_API_URL=http://localhost:3000/api/incidents
NEXTJS_INTERNAL_API_KEY=your-secret-key

# YOLO configuration
YOLO_MODEL_PATH=yolo11n.pt
FRAME_SKIP=10
CONFIDENCE_THRESHOLD=0.85

# Detection Target Classes (comma-separated). Set to "car,truck,motorcycle,bus" for standard COCO testing
DETECTION_CLASSES=accident

# RTSP Stream configuration
MAX_RTSP_FRAMES=1000

# Server configuration
PORT=8000
